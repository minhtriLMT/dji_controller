<?xml version="1.0" encoding="utf-8"?>
<!-- Rãnh thanh góc camera: nền mờ + phần đã kéo màu xanh -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical" android:height="3dp">
        <shape android:shape="rectangle"><solid android:color="#40FFFFFF" /><corners android:radius="2dp" /></shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical" android:height="3dp">
        <clip><shape android:shape="rectangle"><solid android:color="#9969F0AE" /><corners android:radius="2dp" /></shape></clip>
    </item>
</layer-list>
