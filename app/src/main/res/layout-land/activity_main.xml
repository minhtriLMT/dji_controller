<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera drone toàn màn hình -->

    <!-- Thanh trạng thái phía trên -->

    <TextureView
        android:id="@+id/video_preview_texture_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        android:background="#00000000"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Máy bay trên mặt đất - Đang kết nối..."
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGpsAndSdStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="GPS: 0 | Pin: --% | RC: --% | Tìm drone..."
                android:textColor="#E8FFF4"
                android:textSize="9sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCameraMenu"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#FFC107"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- Tâm ngắm giữa camera -->
    <TextView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:text="+"
        android:textColor="#DDFFFFFF"
        android:textSize="36sp" />
    <!-- THỜI GIAN QUAY VIDEO -->
    <TextView
        android:id="@+id/tvVideoTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="55dp"
        android:text="00:00"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:background="#66000000"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />
    <!-- Thông tin nhiệm vụ phía trên bên phải -->
    <LinearLayout
        android:id="@+id/taskInformation"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_alignParentStart="true"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:background="@android:color/transparent"
        android:elevation="10dp"
        android:orientation="vertical"
        android:padding="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Khu vực đã giám sát"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvFieldArea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00 ha"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Số ảnh đã thu thập"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvPhotoCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 tấm"
                android:textColor="#69F0AE"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Khóa lộ trình và quay lại điểm dừng -->
    <LinearLayout
        android:id="@+id/routeControlPanel"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/taskInformation"
        android:layout_alignParentStart="true"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:elevation="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnLockRoute"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#FFFFFF"
            android:minHeight="0dp"
            android:padding="2dp"
            android:text="WP"
            android:textAllCaps="false"
            android:textColor="#111111"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnReturnStop"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:minHeight="0dp"
            android:padding="2dp"
            android:text="RTH"
            android:textAllCaps="false"
            android:textColor="#111111"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Menu nhập thông số -->



    <FrameLayout
        android:id="@+id/miniMap"
        android:layout_width="210dp"
        android:layout_height="100dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="8dp"
        android:elevation="10dp">

        <org.maplibre.android.maps.MapView
            android:id="@+id/miniMapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

<!--        &lt;!&ndash; Nút mở bản đồ lớn &ndash;&gt;-->
<!--        <TextView-->
<!--            android:id="@+id/btnOpenFullMap"-->
<!--            android:layout_width="22dp"-->
<!--            android:layout_height="20dp"-->
<!--            android:layout_gravity="top|end"-->
<!--            android:layout_margin="4dp"-->
<!--            android:background="#DDFFFFFF"-->
<!--            android:gravity="center"-->
<!--            android:text="◎"-->
<!--            android:textColor="#222222"-->
<!--            android:textSize="18sp" />-->

        <!-- Tiêu đề phía dưới -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_gravity="bottom"
            android:background="#B3000000"
            android:gravity="center"
            android:text="Bản đồ hành trình"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- Thông số bay dưới giữa -->
    <LinearLayout
        android:id="@+id/bottomTelemetry"
        android:layout_width="280dp"
        android:layout_height="30dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="8dp"
        android:background="#A6000000"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">

        <TextView
            android:id="@+id/tvTelemetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Cao: 0.0m | Tốc độ: 0.0m/s | Cách đích: 0.0m"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Gimbal bên phải -->
    <SeekBar
        android:id="@+id/seekBarGimbal"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="220dp"
        android:max="180"
        android:progress="90" />

    <!-- ===================================================== -->
    <!-- CAMERA CONTROL -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/cameraControlPanel"
        android:layout_width="190dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#CC000000"
        android:elevation="20dp">

        <!-- CHỌN CHẾ ĐỘ -->
        <LinearLayout
            android:layout_width="65dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <!-- THANH CHỌN ẢNH / VIDEO -->
            <FrameLayout
                android:id="@+id/cameraModePicker"
                android:layout_width="100dp"
                android:layout_height="150dp"
                android:layout_gravity="center_vertical"
                android:clipChildren="false">

                <TextView
                    android:id="@+id/tvCameraVideo"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_gravity="center_horizontal|top"
                    android:layout_marginTop="25dp"
                    android:gravity="center"
                    android:text="Video"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:alpha="0.6"
                    android:clickable="false"
                    android:focusable="false" />

                <TextView
                    android:id="@+id/tvCameraPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="25dp"
                    android:gravity="center"
                    android:text="Ảnh"
                    android:textColor="#FFFF00"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:clickable="false"
                    android:focusable="false" />

            </FrameLayout>
        </LinearLayout>


        <!-- NÚT CHỤP + LƯU TRỮ -->
        <LinearLayout
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <!-- KHU VỰC NÚT CHỤP / QUAY -->
            <FrameLayout
                android:id="@+id/cameraCaptureContainer"
                android:layout_width="100dp"
                android:layout_height="150dp"
                android:clipChildren="false">

                <!-- NÚT CHỤP ẢNH KHI ĐANG Ở CHẾ ĐỘ VIDEO -->
                <Button
                    android:id="@+id/btnVideoPhoto"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center_horizontal|top"
                    android:background="@drawable/bg_video_photo"
                    android:backgroundTint="@null"
                    android:padding="0dp"
                    android:visibility="gone"
                    android:contentDescription="Chụp ảnh" />

                <!-- NÚT CHỤP / QUAY CHÍNH -->
                <Button
                    android:id="@+id/btnCaptureManual"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:translationY="40dp"
                    android:background="@drawable/bg_camera_shutter"
                    android:backgroundTint="@null"
                    android:padding="0dp"
                    android:contentDescription="Chụp ảnh" />

            </FrameLayout>

            <!-- NÚT LƯU TRỮ -->
            <Button
                android:id="@+id/btnViewPhotos"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="25dp"
                android:translationY="40dp"
                android:backgroundTint="@android:color/transparent"
                android:text="□"
                android:textColor="@android:color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

        </LinearLayout>
    </LinearLayout>

</RelativeLayout>