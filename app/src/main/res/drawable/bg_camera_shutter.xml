<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Khi nhấn nút -->
    <item android:state_pressed="true">

        <shape android:shape="oval">

            <solid android:color="#DDDDDD" />

            <stroke
                android:width="3dp"
                android:color="#777777" />

            <padding
                android:left="5dp"
                android:top="5dp"
                android:right="5dp"
                android:bottom="5dp" />

        </shape>

    </item>

    <!-- Bình thường -->
    <item>

        <shape android:shape="oval">

            <solid android:color="#FFFFFF" />

            <stroke
                android:width="3dp"
                android:color="#000000" />

            <padding
                android:left="5dp"
                android:top="5dp"
                android:right="5dp"
                android:bottom="5dp" />

        </shape>

    </item>

</selector>