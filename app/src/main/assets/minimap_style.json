{
  "version": 8,
  "sources": {
    "osm-tiles": {
      "type": "raster",
      "tiles": ["https://tile.openstreetmap.org/{z}/{x}/{y}.png"],
      "tileSize": 256,
      "maxzoom": 19,
      "attribution": "&copy; OpenStreetMap Contributors"
    },
    "sat-tiles": {
      "type": "raster",
      "tiles": ["https://mt0.google.com/vt/lyrs=s&x={x}&y={y}&z={z}"],
      "tileSize": 256,
      "maxzoom": 20,
      "attribution": "Imagery &copy; Google"
    }
  },
  "layers": [
    { "id": "minimap-background", "type": "background", "paint": { "background-color": "#20262b" } },
    { "id": "osm-tiles-layer", "type": "raster", "source": "osm-tiles" },
    { "id": "sat-tiles-layer", "type": "raster", "source": "sat-tiles", "layout": { "visibility": "none" } }
  ]
}
