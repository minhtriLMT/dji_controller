<?xml version="1.0" encoding="utf-8"?>
<!-- Ô ảnh/video trong Lưu trữ: viền xanh khi được chọn (setSelected) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F3A2D" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#69F0AE" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#30353D" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#262A31" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
