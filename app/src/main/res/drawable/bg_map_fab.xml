<?xml version="1.0" encoding="utf-8"?>
<!-- Nút tròn nổi trên bản đồ -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="#B3191C21" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#E61F3A2D" />
            <stroke android:width="1.5dp" android:color="#69F0AE" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#E6191C21" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>
</selector>
