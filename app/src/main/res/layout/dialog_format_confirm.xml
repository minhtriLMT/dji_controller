<?xml version="1.0" encoding="utf-8"?>
<!-- Xác nhận format thẻ nhớ: phải gõ đúng chữ FORMAT mới bật được nút -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_st_dialog_danger"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_st_icon_danger"
            android:gravity="center"
            android:text="!"
            android:textColor="#FF6E66"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Format thẻ nhớ?"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFcInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Thao tác này không thể hoàn tác"
                android:textColor="#9AA0A6"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Gõ FORMAT để xác nhận"
        android:textColor="#9AA0A6"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/etFcConfirm"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_wp_input"
        android:hint="FORMAT"
        android:importantForAutofill="no"
        android:inputType="textCapCharacters|textNoSuggestions"
        android:maxLength="10"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#555B63"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFcCancel"
            android:layout_width="96dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_cf_btn_cancel"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="HỦY"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFcFormat"
            android:layout_width="140dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_st_btn_danger"
            android:enabled="false"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="FORMAT"
            android:textColor="@color/txt_cf_btn_fly_danger"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
