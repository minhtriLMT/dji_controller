<?xml version="1.0" encoding="utf-8"?>
<!-- Hộp thoại Cài đặt (nút ⚙): Thẻ nhớ + Độ cao Return To Home. Màn hình ngang: 2 cột. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cf_dialog"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <!-- ===== TIÊU ĐỀ ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_cf_icon"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#69F0AE"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cài đặt drone"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Thẻ nhớ, độ cao bay về Home và thông số chụp của camera"
                android:textColor="#9AA0A6"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStConn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cf_chip"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="● ĐÃ KẾT NỐI"
            android:textColor="#69F0AE"
            android:textSize="11sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_wp_close"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:background="#1FFFFFFF" />

    <!-- ===== TAB ===== -->
    <RadioGroup
        android:id="@+id/rgStTabs"
        android:layout_width="260dp"
        android:layout_height="36dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_wp_segment"
        android:orientation="horizontal"
        android:padding="3dp">

        <RadioButton
            android:id="@+id/rbStTabGeneral"
            style="@style/WpSegment"
            android:checked="true"
            android:text="Chung" />

        <RadioButton
            android:id="@+id/rbStTabCamera"
            style="@style/WpSegment"
            android:text="Camera" />
    </RadioGroup>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="true"
        android:scrollbarSize="2dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/stTabGeneral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- ===== CỘT TRÁI: THẺ NHỚ ===== -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_cf_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/CfSectionTitle"
                    android:text="THẺ NHỚ CAMERA" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStSdUsed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFeatureSettings="tnum"
                        android:maxLines="1"
                        android:text="—"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStSdState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_cf_chip"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="OK"
                        android:textColor="#69F0AE"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbStSd"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:max="1000"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_st_progress" />

                <TextView
                    android:id="@+id/tvStSdFree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Còn trống: —"
                    android:textColor="#9AA0A6"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_cf_warning"
                    android:padding="8dp"
                    android:text="⚠ Format sẽ xóa vĩnh viễn toàn bộ ảnh và video trên thẻ. Hãy tải dữ liệu cần thiết về trước."
                    android:textColor="#FFD54F"
                    android:textSize="10sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="10dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnStFormat"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_st_btn_danger_outline"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="🗑  FORMAT THẺ NHỚ"
                    android:textColor="@color/txt_st_danger"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ===== CỘT PHẢI: RETURN TO HOME ===== -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_cf_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/CfSectionTitle"
                    android:text="ĐỘ CAO RETURN TO HOME" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnStRthMinus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_wp_close"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:stateListAnimator="@null"
                        android:text="−"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:addStatesFromChildren="true"
                        android:background="@drawable/bg_wp_input"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etStRth"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:fontFeatureSettings="tnum"
                            android:gravity="center"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="3"
                            android:minWidth="48dp"
                            android:selectAllOnFocus="true"
                            android:text="—"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="m"
                            android:textColor="#9AA0A6"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnStRthPlus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_wp_close"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:stateListAnimator="@null"
                        android:text="+"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sbStRth"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginTop="8dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:progressDrawable="@drawable/bg_gimbal_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/bg_gimbal_thumb" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/tvStRthMin"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="20 m"
                        android:textColor="#9AA0A6"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvStRthMax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="500 m"
                        android:textColor="#9AA0A6"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStRthCurrent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Đang đọc từ drone…"
                    android:textColor="#9AA0A6"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="ⓘ Khi về Home, drone bay lên độ cao này (nếu đang thấp hơn) để tránh vật cản."
                    android:textColor="#9AA0A6"
                    android:textSize="10sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="10dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnStRthSave"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_cf_btn_fly"
                    android:enabled="false"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="✓  LƯU ĐỘ CAO"
                    android:textColor="@color/txt_cf_btn_fly"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== TAB CAMERA: PHƠI SÁNG ===== -->
        <LinearLayout
            android:id="@+id/stTabCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Cột trái: chế độ + đang dùng + gợi ý -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_cf_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/CfSectionTitle"
                    android:text="CHẾ ĐỘ PHƠI SÁNG" />

                <RadioGroup
                    android:id="@+id/rgStExpMode"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_wp_segment"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <RadioButton
                        android:id="@+id/rbStExpAuto"
                        style="@style/WpSegment"
                        android:text="Tự động" />

                    <RadioButton
                        android:id="@+id/rbStExpManual"
                        style="@style/WpSegment"
                        android:text="Thủ công" />
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Camera đang dùng"
                    android:textColor="#9AA0A6"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvStExpLive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFeatureSettings="tnum"
                    android:text="—"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStExpHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_cf_warning"
                    android:padding="8dp"
                    android:text="ⓘ Bay quét chụp ảnh nên để màn trập từ 1/1000 s trở lên để ảnh không nhòe. Trời tối thì tăng ISO."
                    android:textColor="#FFD54F"
                    android:textSize="10sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="10dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnStExpPreset"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_cf_btn_fly"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="⚡  CHỐNG NHÒE (1/1000 s)"
                    android:textAllCaps="false"
                    android:textColor="@color/txt_cf_btn_fly"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Cột phải: màn trập / ISO / EV -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_cf_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/CfSectionTitle"
                    android:text="THÔNG SỐ" />

                <TextView
                    style="@style/WpFieldLabel"
                                        android:text="Tốc độ màn trập (thủ công)" />

                <LinearLayout
                    android:id="@+id/stRowShutter"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnStShutterMinus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_wp_close"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:stateListAnimator="@null"
                        android:text="−"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tvStShutter"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_wp_input"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center"
                        android:text="—"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnStShutterPlus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_wp_close"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:stateListAnimator="@null"
                        android:text="+"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp" />
                </LinearLayout>

                <TextView
                    style="@style/WpFieldLabel"
                    android:layout_marginTop="8dp"
                    android:text="ISO (thủ công)" />

                <LinearLayout
                    android:id="@+id/stRowIso"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnStIsoMinus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_wp_close"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:stateListAnimator="@null"
                        android:text="−"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tvStIso"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_wp_input"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center"
                        android:text="—"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnStIsoPlus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_wp_close"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:stateListAnimator="@null"
                        android:text="+"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp" />
                </LinearLayout>

                <TextView
                    style="@style/WpFieldLabel"
                    android:layout_marginTop="8dp"
                    android:text="Bù sáng EV (tự động)" />

                <LinearLayout
                    android:id="@+id/stRowEv"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnStEvMinus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_wp_close"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:stateListAnimator="@null"
                        android:text="−"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tvStEv"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_wp_input"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center"
                        android:text="—"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnStEvPlus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_wp_close"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:stateListAnimator="@null"
                        android:text="+"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
