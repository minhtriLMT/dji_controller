<?xml version="1.0" encoding="utf-8"?>
<!-- Đặt tên mảnh ruộng khi lưu -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cf_dialog"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/tvFieldNameTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lưu mảnh ruộng"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvFieldNameInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#9AA0A6"
        android:textSize="11sp" />

    <TextView
        style="@style/WpFieldLabel"
        android:layout_marginTop="12dp"
        android:text="Tên mảnh ruộng" />

    <LinearLayout style="@style/WpInputBox">

        <EditText
            android:id="@+id/edtFieldName"
            style="@style/WpInput"
            android:hint="VD: Ruộng nhà ông Ba"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLength="40"
            android:textColorHint="#555B63"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFieldNameSaveNew"
            style="@style/WpButton"
            android:layout_width="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_wp_btn_outline"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Lưu thành ruộng mới"
            android:textColor="@color/txt_wp_outline"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFieldNameCancel"
            style="@style/WpButton"
            android:layout_width="wrap_content"
            android:background="@drawable/bg_cf_btn_cancel"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Hủy"
            android:textColor="#FFFFFF" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFieldNameSave"
            style="@style/WpButton"
            android:layout_width="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_cf_btn_fly"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="Lưu"
            android:textColor="@color/txt_cf_btn_fly" />
    </LinearLayout>
</LinearLayout>
