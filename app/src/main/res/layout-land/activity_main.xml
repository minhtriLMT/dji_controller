<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera drone toàn màn hình -->

    <!-- Thanh trạng thái phía trên -->

    <TextureView
        android:id="@+id/video_preview_texture_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Thanh trạng thái trên: kết nối (trái) + các ô GPS / Pin / RC / Thẻ / Home (phải) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/bg_topbar_gradient"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:outlineProvider="none"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <View
            android:id="@+id/statusDot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/ic_status_dot"
            android:backgroundTint="#FF5252" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#CC000000"
                android:shadowRadius="4"
                android:text="Đang kết nối drone..."
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Giữ lại cho code cũ; thông tin hiện ở các ô bên phải -->
            <TextView
                android:id="@+id/tvGpsAndSdStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvChipGps"
            style="@style/StatusChip"
            android:text="GPS --" />

        <TextView
            android:id="@+id/tvChipBattery"
            style="@style/StatusChip"
            android:text="PIN --%" />

        <TextView
            android:id="@+id/tvChipRc"
            style="@style/StatusChip"
            android:text="RC --%" />

        <TextView
            android:id="@+id/tvChipSd"
            style="@style/StatusChip"
            android:text="THẺ --" />

        <TextView
            android:id="@+id/tvChipHome"
            style="@style/StatusChip"
            android:text="HOME" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCameraMenu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_wp_close"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="⚙"
            android:textColor="#FFD54F"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- Tâm ngắm giữa camera -->
    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_centerInParent="true"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_crosshair" />
    <!-- THỜI GIAN QUAY VIDEO -->
    <TextView
        android:id="@+id/tvVideoTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="55dp"
        android:background="@drawable/bg_rec_timer"
        android:drawableStart="@drawable/ic_rec_dot"
        android:drawablePadding="8dp"
        android:fontFeatureSettings="tnum"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp"
        android:text="00:00"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />
    <!-- Thông tin nhiệm vụ phía trên bên phải -->
    <LinearLayout
        android:id="@+id/taskInformation"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_alignParentStart="true"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:background="@android:color/transparent"
        android:elevation="10dp"
        android:orientation="vertical"
        android:padding="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Khu vực đã giám sát"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvFieldArea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00 ha"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCaptureLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dữ liệu bay quét"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvPhotoCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa bay"
                android:textColor="#69F0AE"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Khóa lộ trình và quay lại điểm dừng -->
    <LinearLayout
        android:id="@+id/routeControlPanel"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/taskInformation"
        android:layout_alignParentStart="true"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:elevation="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnLockRoute"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#FFFFFF"
            android:minHeight="0dp"
            android:padding="2dp"
            android:text="WP"
            android:textAllCaps="false"
            android:textColor="#111111"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnReturnStop"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:minHeight="0dp"
            android:padding="2dp"
            android:text="RTH"
            android:textAllCaps="false"
            android:textColor="#111111"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Menu nhập thông số -->



    <FrameLayout
        android:id="@+id/miniMap"
        android:layout_width="210dp"
        android:layout_height="100dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="8dp"
        android:elevation="10dp">

        <org.maplibre.android.maps.MapView
            android:id="@+id/miniMapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />




    </FrameLayout>

    <!-- Thông số bay dưới giữa: độ cao / tốc độ ngang / tốc độ đứng / cách Home -->
    <LinearLayout
        android:id="@+id/bottomTelemetry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_tele_card"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <LinearLayout style="@style/TeleBlock">
            <TextView android:id="@+id/tvTeleAlt" style="@style/TeleValue" android:text="0.0 m" />
            <TextView style="@style/TeleLabel" android:text="ĐỘ CAO" />
        </LinearLayout>

        <View style="@style/TeleDivider" />

        <LinearLayout style="@style/TeleBlock">
            <TextView android:id="@+id/tvTeleHSpeed" style="@style/TeleValue" android:text="0.0 m/s" />
            <TextView style="@style/TeleLabel" android:text="TỐC ĐỘ" />
        </LinearLayout>

        <View style="@style/TeleDivider" />

        <LinearLayout style="@style/TeleBlock">
            <TextView android:id="@+id/tvTeleVSpeed" style="@style/TeleValue" android:text="0.0 m/s" />
            <TextView style="@style/TeleLabel" android:text="LÊN / XUỐNG" />
        </LinearLayout>

        <View style="@style/TeleDivider" />

        <LinearLayout style="@style/TeleBlock">
            <TextView android:id="@+id/tvTeleDist" style="@style/TeleValue" android:text="0 m" />
            <TextView android:id="@+id/tvTeleDistLabel" style="@style/TeleLabel" android:text="CÁCH HOME" />
        </LinearLayout>

        <!-- Tốc độ mạng DL/UL (chỉ hiện khi có) -->
        <TextView
            android:id="@+id/tvTeleNet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFeatureSettings="tnum"
            android:maxLines="2"
            android:textColor="#69F0AE"
            android:textSize="9sp"
            android:visibility="gone" />

        <!-- Giữ lại cho code cũ -->
        <TextView
            android:id="@+id/tvTelemetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Góc camera (gimbal): thanh dọc, kéo lên = ngẩng camera, kéo xuống = nhìn xuống.
         Chạm vào số độ để chuyển nhanh 0° <-> -90° (nhìn thẳng xuống ruộng). -->
    <LinearLayout
        android:id="@+id/gimbalPanel"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="194dp"
        android:background="@drawable/bg_gimbal_card"
        android:clipChildren="false"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/tvGimbalAngle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="0°"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            style="@style/GimbalTick"
            android:layout_marginTop="2dp"
            android:text="+20" />

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="104dp"
            android:clipChildren="false">

            <!-- SeekBar ngang xoay 270° thành thanh dọc (giá trị tăng khi kéo lên) -->
            <SeekBar
                android:id="@+id/seekBarGimbal"
                android:layout_width="104dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:background="@null"
                android:max="110"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:progress="90"
                android:progressDrawable="@drawable/bg_gimbal_track"
                android:rotation="270"
                android:splitTrack="false"
                android:thumb="@drawable/bg_gimbal_thumb" />
        </FrameLayout>

        <TextView
            style="@style/GimbalTick"
            android:text="-90" />
    </LinearLayout>

    <!-- ===================================================== -->
    <!-- CAMERA CONTROL -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/cameraControlPanel"
        android:layout_width="190dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_camera_panel"
        android:outlineProvider="none"
        android:elevation="20dp">

        <!-- CHỌN CHẾ ĐỘ -->
        <LinearLayout
            android:layout_width="65dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <!-- THANH CHỌN ẢNH / VIDEO -->
            <!-- Công tắc dọc: khối vàng trượt lên (VIDEO) / xuống (ẢNH). Chạm hoặc vuốt để đổi. -->
            <FrameLayout
                android:id="@+id/cameraModePicker"
                android:layout_width="56dp"
                android:layout_height="112dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mode_track"
                android:padding="4dp">

                <View
                    android:id="@+id/cameraModeThumb"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_gravity="top"
                    android:background="@drawable/bg_mode_thumb"
                    android:elevation="2dp"
                    android:translationY="52dp" />

                <TextView
                    android:id="@+id/tvCameraVideo"
                    style="@style/CameraModeLabel"
                    android:layout_gravity="top"
                    android:drawableTop="@drawable/ic_mode_video"
                    android:text="VIDEO" />

                <TextView
                    android:id="@+id/tvCameraPhoto"
                    style="@style/CameraModeLabel"
                    android:layout_gravity="bottom"
                    android:drawableTop="@drawable/ic_mode_photo"
                    android:text="ẢNH" />
            </FrameLayout>
        </LinearLayout>


        <!-- NÚT CHỤP + LƯU TRỮ -->
        <LinearLayout
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <!-- KHU VỰC NÚT CHỤP / QUAY -->
            <FrameLayout
                android:id="@+id/cameraCaptureContainer"
                android:layout_width="100dp"
                android:layout_height="150dp"
                android:clipChildren="false">

                <!-- NÚT CHỤP ẢNH KHI ĐANG Ở CHẾ ĐỘ VIDEO -->
                <Button
                    android:id="@+id/btnVideoPhoto"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center_horizontal|top"
                    android:background="@drawable/bg_video_photo"
                    android:backgroundTint="@null"
                    android:padding="0dp"
                    android:visibility="gone"
                    android:contentDescription="Chụp ảnh" />

                <!-- NÚT CHỤP / QUAY CHÍNH -->
                <Button
                    android:id="@+id/btnCaptureManual"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:translationY="40dp"
                    android:background="@drawable/bg_camera_shutter"
                    android:backgroundTint="@null"
                    android:padding="0dp"
                    android:contentDescription="Chụp ảnh" />

            </FrameLayout>

            <!-- NÚT LƯU TRỮ -->
            <ImageButton
                android:id="@+id/btnViewPhotos"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginTop="25dp"
                android:translationY="40dp"
                android:background="@drawable/bg_storage_btn"
                android:contentDescription="Mở kho lưu trữ"
                android:elevation="4dp"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_storage_gallery" />

        </LinearLayout>
    </LinearLayout>

</RelativeLayout>