<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera drone phủ toàn màn hình -->
    <TextureView
        android:id="@+id/video_preview_texture_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Thanh trạng thái phía trên (Trong suốt) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:background="#00000000"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="M"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="#FFFFC107"
            android:gravity="center"
            android:text="2"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Máy bay trên mặt đất - Đang kết nối..."
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGpsAndSdStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="GPS: 0 | Pin: --% | RC: --% | Tìm drone..."
                android:textColor="#E8FFF4"
                android:textSize="10sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCameraMenu"
            android:layout_width="45dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#FFFFFF"
            android:textSize="25sp" />
    </LinearLayout>

    <!-- Tâm ngắm giữa màn hình -->
    <TextView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:text="+"
        android:textColor="#DDFFFFFF"
        android:textSize="45sp" />

    <!-- Thông tin nhiệm vụ phía trên bên phải -->
    <LinearLayout
        android:id="@+id/taskInformation"
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:background="#CC20252A"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Khu vực đã giám sát"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00 ha"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Số ảnh đã thu thập"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvPhotoCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 tấm"
                android:textColor="#69F0AE"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Menu nhập thông số (Bên trái, hình chữ nhật nằm ngang nhỏ) -->
    <LinearLayout
        android:id="@+id/missionMenu"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_alignParentStart="true"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:background="#D91B1F22"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CÀI ĐẶT"
                android:textColor="#69F0AE"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnToggleMenu"
                android:layout_width="36dp"
                android:layout_height="24dp"
                android:backgroundTint="#455A64"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="≡"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutMenuContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="H:"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp" />
                    <EditText
                        android:id="@+id/edtAltitude"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:background="#F5F5F5"
                        android:gravity="center"
                        android:inputType="numberDecimal"
                        android:padding="1dp"
                        android:text="5.0"
                        android:textColor="#111111"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lat:"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp" />
                    <EditText
                        android:id="@+id/edtLat"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:background="#F5F5F5"
                        android:gravity="center"
                        android:inputType="numberDecimal|numberSigned"
                        android:padding="1dp"
                        android:text="10.82310"
                        android:textColor="#111111"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lng:"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp" />
                    <EditText
                        android:id="@+id/edtLng"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:background="#F5F5F5"
                        android:gravity="center"
                        android:inputType="numberDecimal|numberSigned"
                        android:padding="1dp"
                        android:text="106.62970"
                        android:textColor="#111111"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <RadioGroup
                android:id="@+id/radioGroupMode"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:gravity="center"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbPhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:buttonTint="#69F0AE"
                    android:checked="true"
                    android:text="Chụp"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />

                <RadioButton
                    android:id="@+id/rbVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#69F0AE"
                    android:text="Quay"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />
            </RadioGroup>
        </LinearLayout>
    </LinearLayout>

    <!-- Bản đồ nhỏ phía dưới bên trái -->
    <FrameLayout
        android:id="@+id/miniMap"
        android:layout_width="260dp"
        android:layout_height="150dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:background="#CC263238"
        android:elevation="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#DDE8F5E9"
            android:gravity="center"
            android:text="GOOGLE MAP\nVị trí và đường bay của drone"
            android:textColor="#455A64"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="#CCFFFFFF"
            android:gravity="center"
            android:text="◎"
            android:textColor="#222222"
            android:textSize="24sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_gravity="bottom"
            android:background="#B3000000"
            android:gravity="center"
            android:text="Bản đồ hành trình"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />
    </FrameLayout>

    <!-- Thông số bay phía dưới (Đã xóa GPS, HOME, HƯỚNG BAY) -->
    <LinearLayout
        android:id="@+id/bottomTelemetry"
        android:layout_width="390dp"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="8dp"
        android:background="#A6000000"
        android:elevation="9dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="7dp">

        <TextView
            android:id="@+id/tvTelemetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Cao: 0.0m | Tốc độ: 0.0m/s | Cách đích: 0.0m"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Gimbal bên phải -->
    <SeekBar
        android:id="@+id/seekBarGimbal"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="100dp"
        android:max="180"
        android:progress="90" />

    <!-- Cụm Toggle Camera Menu (Sẽ hiện ra bên trái nút Toggle) -->
    <LinearLayout
        android:id="@+id/cameraControlPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_toStartOf="@id/btnCameraMenuToggle"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="7dp"
        android:background="#A6000000"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnViewPhotos"
            android:layout_width="70dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#7B1FA2"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="LƯU TRỮ"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnToggleCameraMode"
            android:layout_width="60dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#455A64"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="QUAY"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCaptureManual"
            android:layout_width="60dp"
            android:layout_height="32dp"
            android:backgroundTint="#E91E63"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="CHỤP"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Nút Toggle Camera (Tách riêng sang bên trái sát cụm điều khiển) -->
    <Button
        android:id="@+id/btnCameraMenuToggle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentBottom="true"
        android:layout_toStartOf="@id/cameraTogglePanel"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="7dp"
        android:backgroundTint="#455A64"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:elevation="12dp"
        android:text="≡"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- Nút Format -->
    <LinearLayout
        android:id="@+id/cameraTogglePanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="7dp"
        android:layout_marginBottom="7dp"
        android:elevation="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnFormatSd"
            android:layout_width="85dp"
            android:layout_height="32dp"
            android:backgroundTint="#FF9800"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="FORMAT THẺ"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Các nút điều khiển Start/Cancel bên phải -->
    <LinearLayout
        android:id="@+id/mainControlPanel"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_above="@id/cameraTogglePanel"
        android:layout_marginEnd="7dp"
        android:layout_marginBottom="10dp"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="88dp"
            android:layout_height="46dp"
            android:layout_marginBottom="4dp"
            android:backgroundTint="#FFFFFF"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="▶ BẮT ĐẦU"
            android:textColor="#111111"
            android:textSize="9sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="88dp"
            android:layout_height="42dp"
            android:backgroundTint="#FFFFFF"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="● HỦY"
            android:textColor="#D50000"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
