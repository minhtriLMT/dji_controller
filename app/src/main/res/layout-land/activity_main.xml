<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera drone toàn màn hình -->

    <!-- Thanh trạng thái phía trên -->

    <TextureView
        android:id="@+id/video_preview_texture_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        android:background="#00000000"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Máy bay trên mặt đất - Đang kết nối..."
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGpsAndSdStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="GPS: 0 | Pin: --% | RC: --% | Tìm drone..."
                android:textColor="#E8FFF4"
                android:textSize="9sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCameraMenu"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#FFC107"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- Tâm ngắm giữa camera -->
    <TextView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:text="+"
        android:textColor="#DDFFFFFF"
        android:textSize="36sp" />

    <!-- Thông tin nhiệm vụ phía trên bên phải -->
    <LinearLayout
        android:id="@+id/taskInformation"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="#CC20252A"
        android:elevation="10dp"
        android:orientation="vertical"
        android:padding="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Khu vực đã giám sát"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00 ha"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Số ảnh đã thu thập"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvPhotoCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 tấm"
                android:textColor="#69F0AE"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Khóa lộ trình và quay lại điểm dừng -->
    <LinearLayout
        android:id="@+id/routeControlPanel"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/taskInformation"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:elevation="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnLockRoute"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#FFFFFF"
            android:minHeight="0dp"
            android:padding="2dp"
            android:text="WP"
            android:textAllCaps="false"
            android:textColor="#111111"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnReturnStop"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:minHeight="0dp"
            android:padding="2dp"
            android:text="RTH"
            android:textAllCaps="false"
            android:textColor="#111111"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Menu nhập thông số -->

    <!-- Bản đồ góc trái dưới -->

    <LinearLayout
        android:id="@+id/missionMenu"
        android:layout_width="209dp"
        android:layout_height="140dp"
        android:layout_below="@id/topBar"
        android:layout_alignParentStart="true"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:background="#CC15191C"
        android:elevation="10dp"
        android:orientation="vertical"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CÀI ĐẶT"
                android:textColor="#69F0AE"
                android:textSize="9sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnToggleMenu"
                android:layout_width="32dp"
                android:layout_height="22dp"
                android:backgroundTint="#455A64"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="≡"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutMenuContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="55dp"
                    android:layout_height="wrap_content"
                    android:text="Cao (m)"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />

                <EditText
                    android:id="@+id/edtAltitude"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_weight="1"
                    android:background="#F5F5F5"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:padding="1dp"
                    android:text="5.0"
                    android:textColor="#111111"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="55dp"
                    android:layout_height="wrap_content"
                    android:text="Latitude"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />

                <EditText
                    android:id="@+id/edtLat"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_weight="1"
                    android:background="#F5F5F5"
                    android:gravity="center"
                    android:inputType="numberDecimal|numberSigned"
                    android:padding="1dp"
                    android:text="10.82310"
                    android:textColor="#111111"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="55dp"
                    android:layout_height="wrap_content"
                    android:text="Longitude"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />

                <EditText
                    android:id="@+id/edtLng"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_weight="1"
                    android:background="#F5F5F5"
                    android:gravity="center"
                    android:inputType="numberDecimal|numberSigned"
                    android:padding="1dp"
                    android:text="106.62970"
                    android:textColor="#111111"
                    android:textSize="10sp" />
            </LinearLayout>

            <RadioGroup
                android:id="@+id/radioGroupMode"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbPhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:buttonTint="#69F0AE"
                    android:checked="true"
                    android:text="Chụp ảnh"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />

                <RadioButton
                    android:id="@+id/rbVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#69F0AE"
                    android:text="Quay video"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />
            </RadioGroup>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/miniMap"
        android:layout_width="210dp"
        android:layout_height="100dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="8dp"
        android:elevation="10dp">

        <org.maplibre.android.maps.MapView
            android:id="@+id/miniMapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Nút mở bản đồ lớn -->
        <TextView
            android:id="@+id/btnOpenFullMap"
            android:layout_width="22dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="#DDFFFFFF"
            android:gravity="center"
            android:text="◎"
            android:textColor="#222222"
            android:textSize="18sp" />

        <!-- Tiêu đề phía dưới -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_gravity="bottom"
            android:background="#B3000000"
            android:gravity="center"
            android:text="Bản đồ hành trình"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- Thông số bay dưới giữa -->
    <LinearLayout
        android:id="@+id/bottomTelemetry"
        android:layout_width="280dp"
        android:layout_height="30dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="8dp"
        android:background="#A6000000"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">

        <TextView
            android:id="@+id/tvTelemetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Cao: 0.0m | Tốc độ: 0.0m/s | Cách đích: 0.0m"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Gimbal bên phải -->
    <SeekBar
        android:id="@+id/seekBarGimbal"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="220dp"
        android:max="180"
        android:progress="90" />

    <!-- ===================================================== -->
    <!-- MENU CAMERA VÀ CỤM NÚT GÓC PHẢI DƯỚI -->
    <!-- ===================================================== -->

    <!--
        MENU CAMERA
        Khi mở sẽ nằm bên trái cụm nút chính
    -->
    <LinearLayout
        android:id="@+id/cameraControlPanel"
        android:layout_width="90dp"
        android:layout_height="102dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="139dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:visibility="gone"
        android:elevation="20dp">

        <Button
            android:id="@+id/btnViewPhotos"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginBottom="3dp"
            android:backgroundTint="#7B1FA2"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="LƯU TRỮ"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnToggleCameraMode"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginBottom="3dp"
            android:backgroundTint="#455A64"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="QUAY"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCaptureManual"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:backgroundTint="#E91E63"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="CHỤP"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!--
        NÚT 3 GẠCH
        Nằm NGOÀI LinearLayout chính
        Nằm ngay bên trái FORMAT THẺ
    -->
    <Button
        android:id="@+id/btnCameraMenuToggle"
        android:layout_width="22dp"
        android:layout_height="25dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="130dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#455A64"
        android:elevation="20dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="≡"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- LINEARLAYOUT CHÍNH -->
    <LinearLayout
        android:id="@+id/cameraMainPanel"
        android:layout_width="120dp"
        android:layout_height="114dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:elevation="12dp"
        android:orientation="vertical">

        <!-- KẾT THÚC -->
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginBottom="4dp"
            android:backgroundTint="#FFFFFF"
            android:minHeight="0dp"
            android:padding="2dp"
            android:text="■  KẾT THÚC"
            android:textAllCaps="false"
            android:textColor="#111111"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- TIẾP TỤC -->
        <Button
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginBottom="4dp"
            android:backgroundTint="#FFFFFF"
            android:minHeight="0dp"
            android:padding="2dp"
            android:text="▶  TIẾP TỤC"
            android:textAllCaps="false"
            android:textColor="#777777"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- FORMAT THẺ -->
        <Button
            android:id="@+id/btnFormatSd"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:backgroundTint="#FF9800"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="FORMAT THẺ"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Bắt đầu nhiệm vụ -->
    <Button
        android:id="@+id/btnStart"
        android:layout_width="100dp"
        android:layout_height="38dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="66dp"
        android:backgroundTint="#22A96B"
        android:elevation="12dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="BẮT ĐẦU"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold" />

</RelativeLayout>