<?xml version="1.0" encoding="utf-8"?>
<!-- Nút viền đỏ (Format thẻ) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><solid android:color="#00000000" /><corners android:radius="10dp" /><stroke android:width="1dp" android:color="#3A3F47" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#33F44336" /><corners android:radius="10dp" /><stroke android:width="1dp" android:color="#FF6E66" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#14F44336" /><corners android:radius="10dp" /><stroke android:width="1dp" android:color="#B3F44336" /></shape>
    </item>
</selector>
